{
  "name": "aicore-server",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "resources/[[]ai]/ai-*",
    "resources/[[]ai]/ai-*/web",
    "template/resource"
  ],
  "scripts": {
    "new": "bun template/new.ts",
    "rcon": "bun tools/rcon.ts",
    "build": "bun run --filter \"ai-*\" --filter \"!ai-*-web\" build",
    "typecheck": "bun run --filter \"ai-*\" --filter \"!ai-*-web\" typecheck",
    "lint": "bun run --filter \"ai-*\" --filter \"!ai-*-web\" lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
