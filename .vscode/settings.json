{
  // Every ai-* resource and packages/ are their own git repos inside the server repo, which ignores them;
  // scan deep enough that VS Code opens each one instead of greying it out as ignored.
  "git.autoRepositoryDetection": true,
  "git.repositoryScanMaxDepth": 5,
  "git.repositoryScanIgnoredFolders": ["node_modules", "dist", "artifact"],
  // Prettier with the owner's settings (.prettierrc in every repo) formats on save.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[markdown]": { "editor.formatOnSave": false },
  "[lua]": { "editor.defaultFormatter": null, "editor.formatOnSave": false }
}
